# Environment variables for backup-dash (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

TZ=America/New_York
PORT=3000
STATE_FILE=/backup/state/last_success.json
BACKUP_DIR=/backup
RESTIC_REPO=sftp:restic@192.168.1.2:/restic-target/um790
RESTIC_PASSWORD=
RESTIC_SSH_KEY=/secrets/id_restic_ed25519
NAS_HOST=192.168.1.2
NAS_PORT=2222
NAS_SSH_KEY=/secrets/id_nas_ed25519
NAS_USER=nick
NAS_SHARE=restic-target
DAG_FILE=/dagu/dags/um790-backup.yaml
SUSPEND_FILE=/dagu/suspend/um790-backup
NEXT_RUN_CRON=30 3 * * *
HISTORY_PATH=/data/history.jsonl
